{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bily JavaScript SDK",
  "description": "Install Bily and track reliable browser events with the official JavaScript SDK.",
  "colors": {
    "primary": "#4F46E5",
    "light": "#818CF8",
    "dark": "#4F46E5"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Install Bily",
            "pages": [
              "sdk/html",
              "sdk/javascript",
              "sdk/react",
              "sdk/nextjs"
            ]
          },
          {
            "group": "Track events",
            "pages": [
              "guides/verification",
              "guides/pageviews",
              "guides/custom-events",
              "guides/ecommerce",
              "guides/client-data"
            ]
          },
          {
            "group": "Operate safely",
            "pages": [
              "privacy/data-safety",
              "troubleshooting",
              "migrations/1-1"
            ]
          }
        ]
      },
      {
        "tab": "SDK reference",
        "icon": "brackets-curly",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "api-reference/overview"
            ]
          },
          {
            "group": "Methods",
            "pages": [
              "api-reference/init",
              "api-reference/track",
              "api-reference/ready",
              "api-reference/get-bily-tracking-id"
            ]
          },
          {
            "group": "Types",
            "pages": [
              "api-reference/events",
              "api-reference/payload"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Bily",
          "href": "https://bily.ai",
          "icon": "house"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@bily.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Bily",
      "href": "https://app.bily.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "redirects": [
    {
      "source": "/development",
      "destination": "/quickstart"
    },
    {
      "source": "/essentials/:slug*",
      "destination": "/quickstart"
    },
    {
      "source": "/ai-tools/:slug*",
      "destination": "/quickstart"
    },
    {
      "source": "/api-reference/introduction",
      "destination": "/api-reference/overview"
    },
    {
      "source": "/api-reference/endpoint/:slug*",
      "destination": "/api-reference/overview"
    }
  ]
}
