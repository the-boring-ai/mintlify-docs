{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bily developer docs",
  "description": "Connect your website once. Use trusted customer data across Bily Apps, analytics, APIs, and AI workflows.",
  "seo": {
    "metatags": {
      "canonical": "https://docs.bily.ai"
    }
  },
  "colors": {
    "primary": "#000000"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "concepts/what-is-bily",
              "concepts/bily-apps",
              "concepts/glossary",
              "quickstart"
            ]
          },
          {
            "group": "Plan and launch",
            "pages": [
              "guides/implementation-planning",
              "guides/event-data-model",
              "guides/identity-attribution",
              "guides/api-mcp-selection",
              "guides/production-rollout"
            ]
          },
          {
            "group": "Install Bily",
            "pages": [
              "sdk/overview",
              "sdk/html",
              "sdk/javascript",
              "sdk/react",
              "sdk/nextjs",
              "sdk/vue",
              "sdk/nuxt",
              "sdk/sveltekit",
              "sdk/angular",
              "sdk/astro",
              "sdk/react-router-framework",
              "guides/first-party-tracking"
            ]
          },
          {
            "group": "Track events",
            "pages": [
              "guides/verification",
              "guides/pageviews",
              "guides/custom-events",
              "guides/ecommerce",
              "guides/client-data"
            ]
          },
          {
            "group": "Operate safely",
            "pages": [
              "guides/validation-debugging",
              "guides/privacy-governance",
              "privacy/data-safety",
              "troubleshooting",
              "troubleshooting/faqs",
              "migrations/2-0"
            ]
          }
        ]
      },
      {
        "tab": "SDK reference",
        "icon": "brackets-curly",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "api-reference/overview"
            ]
          },
          {
            "group": "Methods",
            "pages": [
              "api-reference/init",
              "api-reference/track",
              "api-reference/ready",
              "api-reference/get-bily-tracking-id"
            ]
          },
          {
            "group": "Types",
            "pages": [
              "api-reference/events",
              "api-reference/payload"
            ]
          }
        ]
      },
      {
        "tab": "Bily API",
        "icon": "terminal",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "rest-api/overview",
              "rest-api/authentication",
              "rest-api/quickstart",
              "rest-api/scoping",
              "rest-api/errors"
            ]
          },
          {
            "group": "Endpoint reference",
            "openapi": {
              "source": "/openapi.json",
              "directory": "rest-reference"
            }
          }
        ]
      },
      {
        "tab": "Bily MCP",
        "icon": "robot",
        "groups": [
          {
            "group": "Connect",
            "pages": [
              "mcp/overview",
              "mcp/quickstart",
              "mcp/client-configuration",
              "mcp/authentication"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "mcp/tools",
              "mcp/examples"
            ]
          },
          {
            "group": "Operate safely",
            "pages": [
              "mcp/safety",
              "mcp/troubleshooting"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Bily",
          "href": "https://bily.ai",
          "icon": "house"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@bily.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Bily",
      "href": "https://app.bily.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required"
    }
  },
  "redirects": [
    {
      "source": "/development",
      "destination": "/quickstart"
    },
    {
      "source": "/essentials/:slug*",
      "destination": "/quickstart"
    },
    {
      "source": "/ai-tools/:slug*",
      "destination": "/quickstart"
    },
    {
      "source": "/api-reference/introduction",
      "destination": "/api-reference/overview"
    },
    {
      "source": "/api-reference/endpoint/:slug*",
      "destination": "/api-reference/overview"
    },
    {
      "source": "/migrations/1-1",
      "destination": "/migrations/2-0"
    },
    {
      "source": "/sdk/troubleshooting",
      "destination": "/troubleshooting"
    }
  ]
}
